# ============================================================================
# Firebase Client config (safe to expose to the browser — NEXT_PUBLIC_* only)
# Get these from: Firebase Console > Project settings > General > Your apps > Web app
# ============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================================
# Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_, never
# commit, never send to the client). Generate a service account key from:
# Firebase Console > Project settings > Service accounts > Generate new private key
# Paste the private key with literal \n for newlines, as a single-line string.
# ============================================================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ============================================================================
# Admin allowlist (defense-in-depth alongside custom claims).
# Comma-separated list of Firebase Auth UIDs allowed to use /admin.
# ============================================================================
ADMIN_UID_ALLOWLIST=

# ============================================================================
# Session cookie
# ============================================================================
# Random 32+ byte secret used to sign/verify additional CSRF state. Generate
# with: openssl rand -base64 32
SESSION_COOKIE_SECRET=
# Session lifetime in seconds (default 5 days, Firebase's max for session cookies is 14 days)
SESSION_EXPIRES_IN_SECONDS=432000

# ============================================================================
# Contact form / rate limiting
# ============================================================================
# Max contact form submissions allowed per IP within the rate-limit window
CONTACT_RATE_LIMIT_MAX=5
# Rate-limit window in seconds
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# ============================================================================
# Cloudinary (image uploads — replaces Firebase Storage, which requires a
# paid "Blaze" plan. Cloudinary's free tier is enough for a portfolio.)
# Get these from: Cloudinary Console > Dashboard
# CLOUDINARY_API_SECRET is SERVER ONLY — never prefix with NEXT_PUBLIC_.
# ============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# GitHub Activity integration (optional — the feature degrades to its empty
# state everywhere if these are left unset; nothing else breaks).
# ============================================================================
# Personal access token (fine-grained, or classic with only `public_repo`/
# `read:user` scope) used server-side to call the GitHub REST + GraphQL
# APIs. NEVER prefix with NEXT_PUBLIC_ — this must never reach the browser.
GITHUB_TOKEN=
# Shared secret checked against this project's GitHub webhook's
# `X-Hub-Signature-256` header (see README for how to set up the webhook).
GITHUB_WEBHOOK_SECRET=
# Shared secret checked against the `Authorization: Bearer <secret>` header
# on GET/POST /api/github/sync. NOTE: this is deliberately NOT named
# `CRON_SECRET`, so Vercel Cron will NOT send it automatically — see the
# doc comment in src/app/api/github/sync/route.ts and the README's GitHub
# Activity section for how to schedule this endpoint in production.
GITHUB_SYNC_CRON_SECRET=
# How long (in minutes) cached GitHub data is considered fresh before the
# public UI shows a "data mungkin tidak terbaru" hint. Default: 360 (6h).
GITHUB_SYNC_CACHE_TTL_MINUTES=360

# ============================================================================
# Email notifikasi contact form (opsional — pesan tetap tersimpan ke
# Firestore tanpa ini, cuma tidak ada email yang terkirim ke kamu).
# Daftar gratis di resend.com (3000 email/bulan gratis, tanpa kartu kredit).
# ============================================================================
# Dari Resend Dashboard > API Keys. SERVER ONLY — jangan NEXT_PUBLIC_.
RESEND_API_KEY=
# Email tujuan notifikasi (email kamu sendiri).
CONTACT_NOTIFICATION_EMAIL=
# Alamat pengirim. Default onboarding@resend.dev bisa dipakai langsung
# tanpa verifikasi domain (cocok untuk mulai/testing). Untuk domain sendiri
# (mis. contact@domainmu.com), verifikasi dulu domainnya di Resend Dashboard.
CONTACT_EMAIL_FROM=onboarding@resend.dev

# ============================================================================
# Site
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
